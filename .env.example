# SecureRelease settings. Copy this file to ".env", fill in what you need, then run:
#
#     cp .env.example .env
#     securerelease run
#
# Or let the tool ask you the questions and create ".env" for you:   securerelease init
#
# Rules
#   * Leave a line empty or delete it to skip that setting.
#   * Command-line flags override this file; real environment variables override this file too.
#   * NEVER commit ".env" (it is git-ignored). It can contain tokens and passwords.
#   * Only scan systems you own or are explicitly authorized to test.

# ---------------------------------------------------------------- What to scan
# Website / web UI to scan (UI scanner).
SECURERELEASE_UI_URL=https://staging.example.com

# API base URL to scan (API scanner).
SECURERELEASE_API_URL=https://api.staging.example.com

# OpenAPI / Swagger file path or URL. Leave empty to auto-discover
# (/openapi.json, /swagger.json, /v3/api-docs). Needed for good API coverage.
SECURERELEASE_OPENAPI_SPEC=

# Repository folder to scan for vulnerable dependencies, secrets and insecure code
# (needs Trivy, Gitleaks and Semgrep installed; see "securerelease doctor"). Use . for the current folder.
SECURERELEASE_SOURCE=

# ----------------------------------------------------- Authentication (optional)
# Use TEST accounts on staging, never real users or production credentials.
#
# API bearer token for test user A. A bare token is sent as "Authorization: Bearer <token>".
# Include the scheme for other types, e.g. "Basic dXNlcjpwYXNz".
SECURERELEASE_API_TOKEN=
# API token for a SECOND test user. With SECURERELEASE_AUTHORIZED=true this enables the
# object-level authorization (BOLA/IDOR) check between the two users.
SECURERELEASE_API_TOKEN_B=
# Custom API auth header instead of a bearer token, written as "Header-Name: value".
SECURERELEASE_API_AUTH_HEADER=

# Website login. Set the login page URL plus username and password, or supply a header/cookie.
SECURERELEASE_UI_LOGIN_URL=
SECURERELEASE_UI_USERNAME=
SECURERELEASE_UI_PASSWORD=
# Alternative: a header or cookie sent to the website, e.g. "Cookie: session=abc123".
SECURERELEASE_UI_AUTH_HEADER=
# Alternative: a Playwright storage-state JSON file of a logged-in session.
SECURERELEASE_UI_STORAGE_STATE=

# ------------------------------------------------------------ Behaviour (optional)
# Set to true ONLY for apps on localhost or a private network that you own.
SECURERELEASE_ALLOW_PRIVATE_TARGETS=false

# Set to true to enable ACTIVE tests: fuzzing, a burst of 30 requests (rate limit),
# BOLA/IDOR replay and reflected-input / open-redirect probes. Only for systems you own.
SECURERELEASE_AUTHORIZED=false

# Let the API scanner send POST/PUT/PATCH using sample bodies. Disposable test data only.
# (DELETE requests are never sent.)
SECURERELEASE_ALLOW_MUTATING=false

# auto (browser if Playwright is installed, else crawler), crawler, or browser.
SECURERELEASE_UI_ENGINE=auto
SECURERELEASE_MAX_PAGES=25
SECURERELEASE_MAX_REQUESTS=300

# Force a profile (baseline, ui, api, repository, full, dast). Empty = chosen from the targets above.
SECURERELEASE_PROFILE=

# --------------------------------------------------------------------- Report
# html, json, markdown, sarif or text.
SECURERELEASE_FORMAT=html
# Where to write it. Empty = reports/securerelease-report.<ext>.
SECURERELEASE_OUTPUT=
# Severities that make the command exit with code 1 (CI gate).
SECURERELEASE_FAIL_ON=critical,high
# true = never fail on findings (scan errors still return exit code 2).
SECURERELEASE_NO_FAIL_ON_FINDINGS=false
